diff --git a/lib/libkmc/src/rand.c b/lib/libkmc/src/rand.c
index 5b416f2..1487273 100644
--- a/lib/libkmc/src/rand.c
+++ b/lib/libkmc/src/rand.c
@@ -2,9 +2,17 @@
 #include <stdlib.h>
 
 static s32 sRandNext;
+#ifdef TARGET_HANDHELD
+/* the calls so far: the release review's clock (hh/src/hh_host.c HM64_CLOCK=rand; the N64 reference counts the same
+ * calls by stepping this LCG between two reads of sRandNext) */
+unsigned int hh_rand_calls;
+#endif
 
 int rand() {
     sRandNext = sRandNext * 1103515245 + 12345;
+#ifdef TARGET_HANDHELD
+    hh_rand_calls++;
+#endif
 
     return ((u32)((sRandNext + 1) >> 16) % (RAND_MAX + 1));
 }
diff --git a/lib/libmus/src/player.c b/lib/libmus/src/player.c
index 4409a4d..ceed975 100644
--- a/lib/libmus/src/player.c
+++ b/lib/libmus/src/player.c
@@ -1106,6 +1106,61 @@ static float __MusIntPowerOf2(float x)
   NONE
 *-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*/
 
+#ifdef TARGET_HANDHELD
+/* The pointer bank as the ROM has it (big-endian) to the host's order, before the remap: the header, the wave list
+ * and every wave table, ADPCM loop and codebook it reaches (each once: tables are shared). */
+static unsigned long __hhSeen[2048];
+static int __hhSeenN;
+static int __hhOnce(void *p)
+{
+  int k;
+  for (k = 0; k < __hhSeenN; k++)
+    if (__hhSeen[k] == (unsigned long)p) return 0;
+  if (__hhSeenN < 2048) __hhSeen[__hhSeenN++] = (unsigned long)p;
+  return 1;
+}
+static void __hhSwap32s(void *p, int n) { unsigned long *w = p; while (n--) { *w = __builtin_bswap32(*w); w++; } }
+static void __hhSwap16s(void *p, int n) { unsigned short *h = p; while (n--) { *h = __builtin_bswap16(*h); h++; } }
+static void __hhBankToHost(char *pptr)
+{
+  ptr_bank_t *b = (ptr_bank_t *)pptr;
+  unsigned long *wl;
+  int i;
+  __hhSeenN = 0;
+  __hhSwap32s(&b->flags, 1 + 3 + 1 + 3); /* flags, wbk_name[3], count, basenote, detune, wave_list */
+  wl = (unsigned long *)(pptr + (unsigned long)b->wave_list);
+  __hhSwap32s(wl, b->count);
+  for (i = 0; i < b->count; i++)
+  {
+    ALWaveTable *w;
+    if (!wl[i]) continue;
+    w = (ALWaveTable *)(pptr + wl[i]);
+    if (!__hhOnce(w)) continue;
+    __hhSwap32s(&w->base, 2);
+    __hhSwap32s(&w->waveInfo, 2);
+    if (w->type == AL_ADPCM_WAVE)
+    {
+      if (w->waveInfo.adpcmWave.loop && __hhOnce(pptr + (unsigned long)w->waveInfo.adpcmWave.loop))
+      {
+        ALADPCMloop *l = (ALADPCMloop *)(pptr + (unsigned long)w->waveInfo.adpcmWave.loop);
+        __hhSwap32s(l, 3);
+        __hhSwap16s(l->state, 16);
+      }
+      if (w->waveInfo.adpcmWave.book && __hhOnce(pptr + (unsigned long)w->waveInfo.adpcmWave.book))
+      {
+        ALADPCMBook *k = (ALADPCMBook *)(pptr + (unsigned long)w->waveInfo.adpcmWave.book);
+        __hhSwap32s(k, 2);
+        __hhSwap16s(k->book, k->order * k->npredictors * 8);
+      }
+    }
+    else if (w->waveInfo.rawWave.loop && __hhOnce(pptr + (unsigned long)w->waveInfo.rawWave.loop))
+    {
+      __hhSwap32s(pptr + (unsigned long)w->waveInfo.rawWave.loop, 3);
+    }
+  }
+}
+#endif
+
 static void __MusIntRemapPtrBank(char *pptr, char *wptr)
 {
   int i,bankLen;
@@ -1116,6 +1171,10 @@ static void __MusIntRemapPtrBank(char *pptr, char *wptr)
   unsigned long base;
 
   ptrfile_addr = (ptr_bank_t *)pptr;
+#ifdef TARGET_HANDHELD
+  if (!(ptrfile_addr->flags & 0x80) && !(ptrfile_addr->flags & PTRFLAG_REMAPPED)) /* raw: the flag bit sits in the top byte */
+    __hhBankToHost(pptr);
+#endif
   /* return if already remapped */
   if (ptrfile_addr->flags&PTRFLAG_REMAPPED)
     return;
diff --git a/lib/libmus/src/player_api.c b/lib/libmus/src/player_api.c
index 4ff5bec..34fca71 100644
--- a/lib/libmus/src/player_api.c
+++ b/lib/libmus/src/player_api.c
@@ -205,6 +205,24 @@ unsigned long MusStartSong(void *addr)
 
   song_addr = addr;
   work_addr = addr;
+#ifdef TARGET_HANDHELD
+  /* the song as the ROM has it (big-endian): its header and the channel, volume and pitch bend offset tables to
+   * the host's order, once (a converted song's channel count reads small) */
+  if (work_addr[0] > 0xFFFF)
+  {
+    unsigned long *t;
+    int k, n;
+    for (k = 0; k < 1 + SONGTPTRS; k++)
+      work_addr[k] = __builtin_bswap32(work_addr[k]);
+    n = work_addr[0];
+    for (k = 0; k < 3; k++)
+    {
+      t = (unsigned long *)((char *)addr + work_addr[1 + k]);
+      for (i = 0; i < n; i++)
+        t[i] = __builtin_bswap32(t[i]);
+    }
+  }
+#endif
   count = *work_addr++;
 #ifdef SUPPORT_SONGWAVELOOKUP
   work_addr++;
