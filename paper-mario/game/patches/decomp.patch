index 3f780743f..53a13df15 100644
--- a/src/audio/bgm_player.c
+++ b/src/audio/bgm_player.c
@@ -13,6 +13,27 @@ extern u8 SeqCmdArgCounts[];
 
 static void au_bgm_stop_player(BGMPlayer* player);
 
+#ifdef PM64_PORT
+/* A command's argument bytes land in SeqArgs.raw[] in stream order, and its 16- and 32-bit fields are then read as
+ * numbers: in host order on a little-endian host, or tempos, fade times and the Branch/Detour offsets come out
+ * byte-reversed (a song that branches jumped into garbage: the Toad Town Tunnels' music). */
+static void port_seq_args_to_host(s32 opcode, u8* raw) {
+    // a bit test, not a switch: a jump table would be data in the asset region, which the ROM rebuilds
+    const u32 u16First = 1u << (0xE0 - 0xE0) | 1u << (0xE4 - 0xE0) | 1u << (0xE5 - 0xE0) | 1u << (0xEF - 0xE0) |
+                         1u << (0xF6 - 0xE0) | 1u << (0xFC - 0xE0) | 1u << (0xFE - 0xE0);
+    u8 t;
+    if (opcode == 0xFD) { // EventTrigger: u32 eventInfo (three bytes read, the fourth left from before, as on the N64)
+        t = raw[0]; raw[0] = raw[3]; raw[3] = t;
+        t = raw[1]; raw[1] = raw[2]; raw[2] = t;
+    } else if (opcode >= 0xE0 && (u16First >> (opcode - 0xE0) & 1)) {
+        // MasterTempo, MasterTempoFade (then its u16 value), MasterVolumeFade, TrackDetune, TrackVolumeFade, Branch
+        // and Detour: a u16 first
+        t = raw[0]; raw[0] = raw[1]; raw[1] = t;
+        if (opcode == 0xE4) { t = raw[2]; raw[2] = raw[3]; raw[3] = t; }
+    }
+}
+#endif
+
 static s32 au_bgm_bpm_to_tempo(BGMPlayer* player, u32 tempo);
 
 static u8 au_bgm_get_random_pan(BGMPlayer* player, u8 arg1, u8 arg2);
@@ -1380,6 +1401,9 @@ void au_bgm_player_update_playing(BGMPlayer *player) {
                                 POST_BGM_READ();
                             }
                             bgm_args_done:
+#ifdef PM64_PORT
+                            port_seq_args_to_host(opcode, player->seqCmdArgs.raw);
+#endif
                             CurrentSeqCmdHandler = SeqCmdHandlers[opcode - 0xE0];
                             CurrentSeqCmdHandler(player, track);
                         }
