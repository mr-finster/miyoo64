+#ifdef TARGET_HANDHELD
+/* The handheld build: soundfont envelopes are converted to the host's byte order with the fonts, but an envelope a
+ * sequence's script points at (the "env" command: seqplayer.c, layer and channel) lies in the sequence's own data,
+ * which stays big-endian. Read those points swapped. Without this every such envelope had its delays and levels
+ * byte-swapped: MM 1.0.0/1.0.1's missing or near-silent sound effects (the fairies' whoosh in the intro, Skull Kid). */
+static s16 AudioEffects_EnvS16(AdsrState* adsr, s16 v) {
+    const u8* p = (const u8*)adsr->envelope;
+    const AudioAllocPool* a = &gAudioCtx.seqCache.persistent.pool;
+    const AudioAllocPool* b = &gAudioCtx.seqCache.temporary.pool;
+    s32 i;
+    s32 inSeq = (p >= a->startAddr && p < a->startAddr + a->size) || (p >= b->startAddr && p < b->startAddr + b->size);
+    for (i = 0; !inSeq && i < ARRAY_COUNT(gAudioCtx.permanentEntries); i++) { /* seq 0 (the sound effects) is permanent */
+        const AudioCacheEntry* e = &gAudioCtx.permanentEntries[i];
+        inSeq = e->tableType == SEQUENCE_TABLE && e->addr != NULL && p >= e->addr && p < e->addr + e->size;
+    }
+    if (inSeq) {
+        u16 r = (u16)v;
+        return (s16)((r << 8) | (r >> 8));
+    }
+    return v;
+}
