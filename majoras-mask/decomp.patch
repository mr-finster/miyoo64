@@ -358,6 +358,54 @@ void Graph_Update(GraphicsContext* gfxCtx, GameState* gameState) {
     Graph_ExecuteAndDraw(gfxCtx, gameState);
 }
 
+#if defined(TARGET_HANDHELD)
+/* The handheld's game loop: Graph_ThreadEntry's own, with its state in game memory (a save state holds it and a
+ * load resumes the loop exactly there) and the port's boundary between two whole frames (hh_mm.c HhMm_Boundary:
+ * save states, MENU's EXIT, SIGTERM, the watchdog's heartbeat). */
+GraphicsContext gHhGfxCtx;
+GameStateOverlay* volatile gHhOvl;
+GameStateOverlay* volatile gHhNextOvl;
+GameState* volatile gHhGameState;
+s32 HhMm_Boundary(GameStateOverlay* ovl);
+void HhMm_StateEvent(const char* what, GameStateOverlay* ovl);
+
+void Graph_ThreadEntry(void* arg) {
+    gZBufferLoRes = malloc(sizeof(*gZBufferLoRes) + sizeof(*gWorkBufferLoRes) + 64 - 1);
+    gZBufferLoRes = (void*)ALIGN64((uintptr_t)gZBufferLoRes);
+    gWorkBufferLoRes = (void*)((u8*)gZBufferLoRes + sizeof(*gZBufferLoRes));
+    gGfxSPTaskOutputBufferHiRes = gGfxSPTaskOutputBufferLoRes = malloc(sizeof(*gGfxSPTaskOutputBufferLoRes));
+    gGfxSPTaskOutputBufferEndLoRes = (u8*)gGfxSPTaskOutputBufferLoRes + sizeof(*gGfxSPTaskOutputBufferLoRes);
+    gGfxSPTaskOutputBufferEndHiRes = (u8*)gGfxSPTaskOutputBufferHiRes + sizeof(*gGfxSPTaskOutputBufferHiRes);
+
+    SysCfb_Init();
+    Fault_SetFrameBuffer(gWorkBuffer, SCREEN_WIDTH, SCREEN_HEIGHT);
+    Graph_Init(&gHhGfxCtx);
+
+    gHhNextOvl = &gGameStateOverlayTable[0];
+    while (gHhNextOvl != NULL) {
+        gHhOvl = gHhNextOvl;
+        Overlay_LoadGameState(gHhOvl);
+        HhMm_StateEvent("init", gHhOvl);
+        gHhGameState = malloc(gHhOvl->instanceSize);
+        bzero(gHhGameState, gHhOvl->instanceSize);
+        GameState_Init(gHhGameState, gHhOvl->init, &gHhGfxCtx);
+        HhMm_StateEvent("running", gHhOvl);
+
+        while (GameState_IsRunning(gHhGameState)) {
+            if (HhMm_Boundary(gHhOvl)) { /* quit: no destroy (the process ends) */
+                return;
+            }
+            Graph_Update(&gHhGfxCtx, gHhGameState);
+        }
+        HhMm_StateEvent("done", gHhOvl);
+        gHhNextOvl = Graph_GetNextGameState(gHhGameState);
+        GameState_Destroy(gHhGameState);
+        free(gHhGameState);
+        Overlay_FreeGameState(gHhOvl);
+    }
+    Graph_Destroy(&gHhGfxCtx);
+}
+#else
