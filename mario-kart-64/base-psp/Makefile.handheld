# Mario Kart 64 -> Miyoo Mini port build (also builds a desktop/x86 debug target).
#
#   make -f Makefile.handheld PLAT=pc      -j$(nproc)   # desktop SDL2 debug build
#   make -f Makefile.handheld PLAT=miyoo   -j$(nproc)   # Miyoo Mini cross build (SDL 1.2, 320x240 x2)
#
# Derived from Makefile.psp: same n64decomp/mk64 game code + src/port libultra
# replacement + F3D interpreter + C audio mixer, but the sceGu backend (src/port/psp)
# is replaced by a software rasterizer + SDL backend (src/port/sdl), and the PSP
# packaging (EBOOT/PRX/PSAR) by a plain ELF link.
#
# Asset split (M6, same scheme as Makefile.psp): the ROM-derived data objects
# have .data renamed to .assetdata and collected into one NOLOAD region after
# .bss, so the shipped ELF carries NO game data. A second, identical link with
# the region as PROGBITS feeds tools/psp/make_assets.py -> build/<plat>/assets.bin
# (the bytes, local only). tools/psp/derive_recipes.py then records how every
# byte of that region derives from the ROM (numbers only -> recipes.bin, ships
# in the zip) and src/port/sdl/assets_handheld.c rebuilds the region on the
# device from the player's own ROM on first start, caching it as assets.bin.
#
# Needs: extracted assets (extract_assets.py us; torch code/header baserom.us.z64),
# the decomp host tools (tools/mio0, tools/n64graphics, tools/torch), GNU make >= 4.

include util.mk

# Platform: pc (desktop SDL2 debug) or miyoo (device cross-build).
# (Comment on its own line — an inline comment would leave trailing spaces in the value.)
PLAT ?= pc
VERSION     := us
TARGET      := mk64
BUILD_DIR   := build/$(PLAT)$(if $(PROFILE),-prof,)$(if $(filter 1,$(UBSAN)),-ubsan,)
ELF         := $(BUILD_DIR)/$(TARGET)
BASEROM     := baserom.$(VERSION).z64

VERBOSE ?= 0
ifeq ($(VERBOSE),0)
  V := @
endif
COLOR ?= 1
ifeq ($(COLOR),1)
NO_COL := \033[0m
GREEN  := \033[0;32m
BLUE   := \033[0;34m
YELLOW := \033[0;33m
endif
PRINT := printf

#==============================================================================#
# Toolchain (per platform)                                                     #
#==============================================================================#
ifeq ($(PLAT),miyoo)
  # Miyoo Mini / Mini Plus (SigmaStar SSD202D: dual Cortex-A7, NEON-VFPv4, 640x480 panel) with
  # the union toolchain (shauninman/union-miyoomini-toolchain: GCC 8.3, glibc 2.28, the device's
  # SDL 1.2 + SDL_ttf + SDL_image in the sysroot). armv7ve (not armv7-a): the Cortex-A7 has the
  # hardware SDIV/UDIV instruction, so / and % in the rasterizer need no __aeabi_idiv* libcall.
  # -ffp-contract=off: VFPv4 has fused multiply-add and GCC contracts a*b+c by default; the x86
  # proxy cannot, so with contraction on the bit-exact sweep proves nothing about the device.
  # HANDHELD selects the shared platform layer (SDL 1.2 backend, NEON, save states, menu), MIYOO
  # the Mini's own bits (keys, paths, power, volume/brightness), rendering 320x240, scaled 2x to
  # the panel (miyoo_video.c).
  MIYOO_TOOLCHAIN ?= /opt/miyoomini-toolchain
  MIYOO_CROSS     ?= $(MIYOO_TOOLCHAIN)/usr/bin/arm-linux-gnueabihf-
  MIYOO_SYSROOT   ?= $(MIYOO_TOOLCHAIN)/usr/arm-linux-gnueabihf/sysroot
  CC   := $(MIYOO_CROSS)gcc
  AS   := $(MIYOO_CROSS)as
  LD   := $(CC)
  OBJCOPY := $(MIYOO_CROSS)objcopy
  OBJDUMP := $(MIYOO_CROSS)objdump
  MARCH := -march=armv7ve+neon-vfpv4 -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -fsingle-precision-constant
  OPT_FLAGS = -O3 -fno-math-errno -fomit-frame-pointer -ffp-contract=off $(EXTRA_CFLAGS)
  AS_ARCH :=
  # 64-bit file offsets: 32-bit glibc's readdir/stat otherwise fail (EOVERFLOW) on filesystems
  # with 64-bit inodes or directory offsets, and the ROM search saw an empty folder.
  SDL_CFLAGS := -I$(MIYOO_SYSROOT)/usr/include -D_GNU_SOURCE=1 -D_REENTRANT -D_FILE_OFFSET_BITS=64
  # no SDL_ttf/SDL_image: the Miyoo menu and first-start screen draw with a built-in font
  SDL_LIBS   := -L$(MIYOO_SYSROOT)/usr/lib -lSDL
  PLAT_DEFINES := TARGET_HANDHELD=1 HANDHELD=1 MIYOO=1
else
  # Desktop debug: 32-bit x86 so pointer/size_t widths match the 32-bit device
  # (PLAT=pc is x86-only by design: -m32). -mfpmath=sse (not x87): strict
  # 32-bit float like the device's VFP, so frame dumps are bit-comparable --
  # x87's 80-bit intermediates otherwise show +/-1 rounding under harmless code
  # motion that never happens on ARM. -ffp-contract=off to match the device.
  # Plain '=' (not '?='): an OPT_FLAGS in the environment must not silently
  # drop these and revert the proxy to x87.
  CC   := gcc
  AS   := as
  LD   := $(CC)
  OBJCOPY := objcopy
  OBJDUMP := objdump
  # -fno-pie: the distro gcc defaults to PIE codegen, which scatters pointer-
  # bearing data over .data.rel/.data.rel.local (the asset split renames whole
  # sections) and adds x86-32 GOT thunks the device never has. We link -no-pie.
  # -malign-data=abi: i386 GCC otherwise pads arrays >= 32 bytes to 32-byte
  # alignment, which breaks the contiguous packed-display-list extents the
  # recipe derivation relies on (ARM and the PSP use natural alignment).
  # -fsingle-precision-constant as the device has it: without it a float expression with a
  # double constant (x * 0.5) is worked in double here and in float there, and the proxy drifted
  # from the device by one LSB in scattered pixels (DK from frame 902). The asset objects keep
  # -fno-single-precision-constant on both (below: they must round as the N64 compiler did).
  MARCH := -m32 -fno-pie -malign-data=abi -fsingle-precision-constant
  OPT_FLAGS = -O2 -fno-math-errno -msse2 -mfpmath=sse -ffp-contract=off $(EXTRA_CFLAGS)
  AS_ARCH := --32
  SDL_CFLAGS := $(shell PKG_CONFIG_PATH=/usr/lib/i386-linux-gnu/pkgconfig pkg-config --cflags sdl2)
  SDL_LIBS   := $(shell PKG_CONFIG_PATH=/usr/lib/i386-linux-gnu/pkgconfig pkg-config --libs sdl2)
  PLAT_DEFINES := TARGET_HANDHELD=1 TARGET_PC=1
endif

#==============================================================================#
# Tools (host, shared with the PSP build)                                      #
#==============================================================================#
TOOLS_DIR     := tools
PYTHON        ?= python3
MIO0TOOL      := $(TOOLS_DIR)/mio0
N64GRAPHICS   := $(TOOLS_DIR)/n64graphics
ASM_BE        := $(PYTHON) $(TOOLS_DIR)/psp/asm_be.py
ASSET_EXTRACT := $(PYTHON) $(TOOLS_DIR)/new_extract_assets.py
TOUCH         := touch
ASSET_DIR     := assets
DATA_DIR      := data
TEXTURES_DIR  := textures

#==============================================================================#
# Sources (same as Makefile.psp, but src/port/sdl instead of src/port/psp)     #
#==============================================================================#
SRC_ASSETS_DIR := assets/code/ceremony_data assets/code/startup_logo assets/code/data_800E45C0 \
                  assets/code/data_800E8700 assets/code/common_data
GAME_SRC_DIRS  := src src/data src/buffers src/racing src/ending src/audio courses $(SRC_ASSETS_DIR)
PORT_SRC_DIRS  := src/port src/port/gfx src/port/audio src/port/sdl
OS_C_FILES     := $(wildcard src/os/gu*.c) src/os/math/sinf.c src/os/math/cosf.c

COURSE_DIRS  := $(shell find courses -mindepth 1 -type d | sort)
COURSE_FILES := $(foreach dir,$(COURSE_DIRS),$(dir)/course_data.c $(dir)/course_offsets.c \
                  $(dir)/course_displaylists.inc.c $(dir)/course_vertices.inc.c)

C_FILES := $(filter-out %.inc.c,$(foreach dir,$(GAME_SRC_DIRS) $(PORT_SRC_DIRS),$(wildcard $(dir)/*.c))) \
           $(OS_C_FILES) $(COURSE_FILES)
# The Mini's second core (miyoo_worker.c): the Miyoo build's only, so the other builds link as before.
ifneq ($(PLAT),miyoo)
  C_FILES := $(filter-out src/port/sdl/miyoo_worker.c src/port/sdl/miyoo_watchdog.c src/port/sdl/miyoo_clock.c src/port/sdl/miyoo_sleepdiag.c,$(C_FILES))
endif

S_FILES := $(filter-out $(DATA_DIR)/rsp.s,$(wildcard $(DATA_DIR)/*.s)) \
           $(wildcard $(DATA_DIR)/karts/*.s) \
           $(DATA_DIR)/sound_data/instrument_sets.s $(DATA_DIR)/sound_data/sequences.s \
           src/port/audio_blobs.s

SEG_TABLES_C := $(BUILD_DIR)/port_seg_tables.c

O_FILES := $(foreach f,$(C_FILES),$(BUILD_DIR)/$(f:.c=.o)) \
           $(foreach f,$(S_FILES),$(BUILD_DIR)/$(f:.s=.o)) \
           $(SEG_TABLES_C:.c=.o)
DEP_FILES := $(O_FILES:.o=.d)

ALL_DIRS := $(BUILD_DIR) $(addprefix $(BUILD_DIR)/,$(GAME_SRC_DIRS) $(PORT_SRC_DIRS) src/os src/os/math $(COURSE_DIRS) \
            $(DATA_DIR) $(DATA_DIR)/karts $(DATA_DIR)/sound_data \
            $(TEXTURES_DIR)/raw $(TEXTURES_DIR)/standalone $(TEXTURES_DIR)/startup_logo \
            $(TEXTURES_DIR)/crash_screen $(TEXTURES_DIR)/trophy $(TEXTURES_DIR)/courses $(TEXTURES_DIR)/common)
DUMMY != mkdir -p $(ALL_DIRS)

#==============================================================================#
# Flags                                                                        #
#==============================================================================#
# NOTE: NO PORT_GE_TL / PORT_GE_CULL — those offload transform+light+cull to the PSP's
# GE (GPU). The device has no GPU for this, so we MUST use gfx_pc.c's CPU transform/clip path
# (gfx_matrix_mul / gfx_clip_interpolate_vert / clipToHyperPlane) feeding the soft rasterizer.
DEFINES := PORT_DRAW_DIST=3000 PORT_MAX_VOICES=18 VERSION_US=1 PORT_PROFILE=1 \
           F3DEX_GBI=1 F3D_OLD=1 NON_MATCHING=1 AVOID_UB=1 _LANGUAGE_C=1 NO_SEGMENTED_MEMORY=1 \
           $(PLAT_DEFINES)
# 16-bit textures stored expanded to 8888: 0 = none, 1 = all, 2 = only small
# ones (<= 4096 texels: everything a race samples; menu backdrops stay 16-bit).
# 2 since v32: the device A/B on DK at 85% measured 149 vs 161 ns per drawn
# pixel against 0 (both full speed), output bit-identical. `make TEX32=0` or
# MK64_TEX32=0/1/2 at run time for another A/B.
TEX32 ?= 2
DEFINES += PORT_TEX32=$(TEX32)
C_DEFINES := $(foreach d,$(DEFINES),-D$(d))

INCLUDE_DIRS := include $(BUILD_DIR) $(BUILD_DIR)/include src src/racing src/ending \
                src/port src/port/gfx src/port/audio src/port/sdl .
DEF_INC_CFLAGS := $(foreach i,$(INCLUDE_DIRS),-I$(i)) $(C_DEFINES) $(SDL_CFLAGS)

# -fno-toplevel-reorder: the decomp indexes past the end of several data tables
# into their neighbours; GCC's default reverse emission breaks those walks.
# -fno-builtin-sinf/cosf/sincosf: GCC merged a sinf + cosf pair on one angle (guRotateF,
# guPerspectiveF, mtxf_projection) into libc's sincosf, and musl 1.2.1's sincosf returns
# garbage from |x| ~ 10 (sincosf(10) = 0, -1; glibc -0.54, -0.84). The records/DATA screens'
# spinning 3D cursor (func_800A66A8) adds >= 6 degrees a frame to a static angle that never
# wraps, so it passed 10 rad (~573 deg) ~3 s into the screen and turned wrong on the device.
# The decomp's own sinf/cosf reduce the range and give the same bits on x86 and ARM.
CFLAGS  := $(OPT_FLAGS) $(MARCH) -std=gnu99 -fsigned-char -fno-strict-aliasing -fwrapv -fno-common -fno-toplevel-reorder \
           -fno-builtin-sinf -fno-builtin-cosf -fno-builtin-sincosf \
           -Wall -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function -Wno-unused-parameter \
           -Wno-missing-braces -Wno-char-subscripts -Wno-sign-compare -Wno-int-in-bool-context \
           -Wno-error=incompatible-pointer-types -Wno-error=int-conversion \
           $(DEF_INC_CFLAGS)
ASFLAGS := $(AS_ARCH) -I include -I $(BUILD_DIR) -I .

# -Ttext-segment=0x10000000: place the binary (and thus its heap) above the N64
# segment window so real pointers never collide with segmented addresses
# (see PORT_REAL_PTR_MIN in port.h / port_seg_to_ptr in segments.c).
LDFLAGS := $(MARCH) -no-pie -Wl,--gc-sections -Wl,-Ttext-segment=0x10000000
# `make ... PLAT=pc PROFILE=1` -> gprof build (gmon.out on a clean exit; use MK64_EXIT_AT).
ifdef PROFILE
  CFLAGS  += -pg -fno-omit-frame-pointer
  LDFLAGS += -pg
endif
LIBS    := $(SDL_LIBS) -lm -lpthread
# Region symbols gfx_pc.c's gfx_is_static_memory() reads: code+data is
# [_ftext, _fbss); __assets_start/__assets_end come from the asset-region
# linker script fragment (below).
LDFLAGS += -Wl,--defsym=_ftext=__executable_start -Wl,--defsym=_fbss=__bss_start

# Debug: `make ... ASAN=1` -> AddressSanitizer (gdb's ptrace does not work under
# the Rosetta emulation, but ASan is pure instrumentation and gives a backtrace).
ifeq ($(ASAN),1)
  CFLAGS  += -fsanitize=address -g -fno-omit-frame-pointer
  LDFLAGS += -fsanitize=address
endif
# `make ... PLAT=pc UBSAN=1` -> report shift counts that are negative or >= the width at run time.
# MIPS and x86 mask the count to 5 bits, ARM uses its low byte (x >> 32 is 0 on the device, x on
# the desktop), so the desktop can hide what the device gets wrong (the OoT port 33d8a76). Likewise
# a float converted to an int it doesn't fit: x86 gives INT_MIN, ARM saturates (float-cast-overflow).
ifeq ($(UBSAN),1)
  CFLAGS  += -fsanitize=shift-exponent,float-cast-overflow -g
  LDFLAGS += -fsanitize=shift-exponent,float-cast-overflow
endif
# N64 ROM-segment symbols that alias data linked in from the .s files.
LDFLAGS += -Wl,--defsym=_sequencesSegmentRomStart=music_sequence_table_header \
           -Wl,--defsym=_instrument_setsSegmentRomStart=instrument_sets \
           -Wl,--defsym=_audio_banksSegmentRomStart=port_audiobanks \
           -Wl,--defsym=_audio_tablesSegmentRomStart=port_audiotables \
           -Wl,--defsym=D_0B002A00=texture_player_select+0x2A00 \
           -Wl,--defsym=_trigTablesSegmentStart=gSineTable -Wl,--defsym=_trigTablesSegmentRomStart=gSineTable

$(BUILD_DIR)/assets/code/startup_logo/startup_logo.o: CFLAGS += -Dreflection_map_gold=reflection_map_gold_logo
# Hot audio code gets the heavier optimisation level.
$(BUILD_DIR)/src/port/audio/mixer.o $(BUILD_DIR)/src/audio/synthesis.o: CFLAGS += -O3 -funroll-loops
# The port's own backend must not hide stranded locals/functions behind the
# decomp-wide -Wno-unused-* (round 13: a refactor left three of them).
$(BUILD_DIR)/src/port/sdl/%.o: CFLAGS += -Wunused-variable -Wunused-but-set-variable -Wunused-function
# miyoo_worker.c (the shared miyoo/kit) names its A/B switch after the port
$(BUILD_DIR)/src/port/sdl/miyoo_worker.o: CFLAGS += -U_GNU_SOURCE '-DMIYOO_WORKER_ENV="MK64_THREADS"'
# miyoo_watchdog.c (the stall report in console.log) likewise: MK64_WATCHDOG=<s>, 0 = off
$(BUILD_DIR)/src/port/sdl/miyoo_watchdog.o: CFLAGS += -U_GNU_SOURCE '-DMIYOO_WD_ENV="MK64_WATCHDOG"'
# miyoo_clock.c (the shared miyoo/kit 27a1311, the CPU clock): MK64_CPUCLOCK=<MHz>, 0 = left alone
$(BUILD_DIR)/src/port/sdl/miyoo_clock.o: CFLAGS += '-DMIYOO_CLOCK_ENV="MK64_CPUCLOCK"'

#==============================================================================#
# Targets                                                                      #
#==============================================================================#
#==============================================================================#
# Asset split (see the header comment)                                         #
#==============================================================================#
# The ROM-derived data objects: everything under assets/, courses/ and data/,
# the audio blobs, and the four src/data tables that are ROM images (textures,
# some_data, data_segment2, path_spawn_metadata). Same list as Makefile.psp.
ASSET_OBJS := $(filter $(BUILD_DIR)/assets/% $(BUILD_DIR)/courses/% $(BUILD_DIR)/data/% \
                       $(BUILD_DIR)/src/port/audio_blobs.o $(BUILD_DIR)/src/data/textures.o \
                       $(BUILD_DIR)/src/data/some_data.o $(BUILD_DIR)/src/data/data_segment2.o \
                       $(BUILD_DIR)/src/data/path_spawn_metadata.o,$(O_FILES))
# Asset objects are data the ROM must reproduce byte for byte (M6 recipes):
# compile-time float->fixed conversions (toFixedPointMatrix in common_data)
# have to round as the N64 compiler did, in double, not with the device's
# -fsingle-precision-constant (D_0D008ED8 differed by one LSB with it).
$(ASSET_OBJS): CFLAGS += -fno-single-precision-constant
ELF_ASSETS   := $(BUILD_DIR)/$(TARGET)_assets.elf
ASSETS_BIN   := $(BUILD_DIR)/assets.bin
LD_NOLOAD    := $(BUILD_DIR)/assets_noload.ld
LD_PROGBITS  := $(BUILD_DIR)/assets_progbits.ld
RECIPES_OUT  := tools/handheld/recipes_$(PLAT).json
RECIPES_JSON := $(RECIPES_OUT)
# Miyoo: the shared ARM recipes (recipes_handheld.json) when it has none of its own. The asset
# objects are plain data for the ARM EABI, so the layout usually comes out the same;
# emit_recipes.py compares the layout id and refuses a mismatch (then run `make -f Makefile.handheld PLAT=miyoo assets-recipes`).
ifeq ($(PLAT),miyoo)
  ifeq ($(wildcard $(RECIPES_JSON)),)
    RECIPES_JSON := tools/handheld/recipes_handheld.json
  endif
endif
RECIPES_BIN  := $(BUILD_DIR)/recipes.bin
# Build stamp: a random word compiled into this link (both of them) and
# written into recipes.bin's trailer, the device's assets.bin header and every
# save state, so the game only ever extracts with, loads a cache from, or
# restores a state of its own build. It takes the same inputs as the $(ELF)
# link (objects + linker script, which follows this Makefile), so nothing can
# relink -- and move .data -- without a new stamp.
STAMP_C      := $(BUILD_DIR)/build_stamp.c
STAMP_O      := $(STAMP_C:.c=.o)
# Page-aligned (4096) region and cache data offset (a future mmap of the
# cache over the region needs both; today the cache is read in).
define ASSET_LD_SCRIPT
SECTIONS\n{\n  .assetdata $(1) : ALIGN(4096) { __assets_start = .; *(.assetdata .assetdata.*) *(.assetrodata .assetrodata.*) . = ALIGN(4096); __assets_end = .; }\n}\nINSERT AFTER .bss;\n
endef
# Every initialised-data section GCC can emit for these objects (plain, PIE
# pointer-bearing variants, merged string/constant pools) -> .asset*. Names
# that do not occur are silently skipped by objcopy.
ASSET_RENAMES := .data=.assetdata .data.rel=.assetdata.rel .data.rel.local=.assetdata.rel.local \
                 .data.rel.ro=.assetdata.relro .data.rel.ro.local=.assetdata.relro.local \
                 .rodata=.assetrodata .rodata.str1.1=.assetrodata.str1 .rodata.str1.4=.assetrodata.str4 \
                 .rodata.str1.8=.assetrodata.str8 .rodata.cst4=.assetrodata.cst4 .rodata.cst8=.assetrodata.cst8 \
                 .rodata.cst16=.assetrodata.cst16
ASSET_RENAME_FLAGS := $(foreach r,$(ASSET_RENAMES),--rename-section $(r))
default: all
all: $(ELF) $(ASSETS_BIN) $(RECIPES_BIN)

$(STAMP_C): $(O_FILES) $(LD_NOLOAD)
	$(V)printf '/* generated per link: recipes.bin and assets.bin must carry this value */\n#include <stdint.h>\nconst uint32_t port_build_stamp = 0x%s;\n' "$$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')" > $@
$(STAMP_O): $(STAMP_C)
	$(V)$(CC) -c $(CFLAGS) -o $@ $<

$(LD_NOLOAD): Makefile.handheld
	$(V)printf '$(call ASSET_LD_SCRIPT,(NOLOAD))' > $@
$(LD_PROGBITS): Makefile.handheld
	$(V)printf '$(call ASSET_LD_SCRIPT,)' > $@

# Slow (minutes): find, for every asset symbol, how it derives from the ROM.
# Needed whenever the asset layout changes (any asset source, compiler or
# flag change): `make -f Makefile.handheld PLAT=miyoo assets-recipes`. The
# emitted JSON carries the assets.bin build id, and recipes.bin refuses to
# build from a stale one.
assets-recipes: $(ASSETS_BIN)
	$(V)mkdir -p tools/handheld
	python3 tools/psp/derive_recipes.py $(ASSETS_BIN) $(BASEROM) -o $(RECIPES_OUT) --cache $(BUILD_DIR)/mio0.cache --report $(BUILD_DIR)/recipes_report.txt

$(RECIPES_BIN): $(wildcard $(RECIPES_JSON)) $(ASSETS_BIN) $(STAMP_C) tools/psp/emit_recipes.py
	$(V)if [ -f $(RECIPES_JSON) ]; then python3 tools/psp/emit_recipes.py $(RECIPES_JSON) $(ASSETS_BIN) -o $@ --stamp $$(sed -n 's/.*= 0x\([0-9a-fA-F]*\);.*/\1/p' $(STAMP_C)); \
	else echo "NOTE: $(RECIPES_JSON) missing - the build cannot extract from a ROM (run: make -f Makefile.handheld PLAT=$(PLAT) assets-recipes)"; printf 'MK64RCP0' > $@; fi

# Compile everything but do not link — the porting-phase workhorse.
objs: $(O_FILES)

# Sources whose data STAYS in the executable (everything that is not an asset
# object). tools/check_provenance.sh verifies each is tracked in git.
ASSET_STEMS  := $(patsubst $(BUILD_DIR)/%.o,%,$(ASSET_OBJS))
CODE_SOURCES := $(filter-out $(addsuffix .c,$(ASSET_STEMS)) $(addsuffix .s,$(ASSET_STEMS)),$(C_FILES) $(S_FILES))
print-code-sources:
	@printf '%s\n' $(CODE_SOURCES)
print-asset-sources:
	@printf '%s\n' $(filter $(addsuffix .c,$(ASSET_STEMS)) $(addsuffix .s,$(ASSET_STEMS)),$(C_FILES) $(S_FILES))

clean:
	$(RM) -r $(BUILD_DIR)

.PHONY: default all assets-recipes objs clean print-code-sources print-asset-sources

define print
  @$(PRINT) "$(GREEN)$(1) $(YELLOW)$(2)$(GREEN) -> $(BLUE)$(3)$(NO_COL)\n"
endef

#==============================================================================#
# Texture + asset generation (same recipes as the PSP/N64 build)               #
#==============================================================================#
$(BUILD_DIR)/%: %.png
	$(call print,Converting:,$<,$@)
	$(V)$(N64GRAPHICS) -i $@ -g $< -f $(lastword $(subst ., ,$@))

$(BUILD_DIR)/textures/%.mio0: $(BUILD_DIR)/textures/%
	$(V)$(MIO0TOOL) -c $< $@

ASSET_INCLUDES := $(shell find $(ASSET_DIR)/include -type f -name "*.mk")
$(foreach inc,$(ASSET_INCLUDES),$(eval include $(inc)))

STANDALONE_TEXTURE_MIO0_FILES := $(addprefix $(BUILD_DIR)/,$(patsubst %.png,%.mio0,$(wildcard $(TEXTURES_DIR)/standalone/*.png)))
RAW_TEXTURE_FILES := $(addprefix $(BUILD_DIR)/,$(patsubst %.png,%,$(wildcard $(TEXTURES_DIR)/raw/*.png)))

COURSE_TEXTURE_HEADERS := $(foreach dir,$(COURSE_DIRS),$(dir)/course_textures.linkonly.h)
%/course_textures.linkonly.h: %/course_offsets.c tools/psp/gen_course_textures.py
	$(V)$(PYTHON) tools/psp/gen_course_textures.py $(lastword $(subst /, ,$*))
$(foreach dir,$(COURSE_DIRS),$(BUILD_DIR)/$(dir)/course_data.o $(BUILD_DIR)/$(dir)/course_displaylists.inc.o): $(COURSE_TEXTURE_HEADERS)

# Torch emits RGBA16/TLUT as native-endian u16; the gfx importers read texel data
# big-endian like the N64. Shadow those .inc.c with byte-swapped copies in build/.
U16_INC_FILES := $(sort $(shell grep -rhA12 -E '^u16 [A-Za-z0-9_]+(\[[0-9]*\])+ = \{' assets/code courses --include=*.c | grep -oE '"[^"]+\.(rgba16|tlut|ia16)\.inc\.c"' | tr -d '"'))
SWAPPED_INC_FILES := $(addprefix $(BUILD_DIR)/,$(U16_INC_FILES))
$(BUILD_DIR)/%.inc.c: %.inc.c tools/psp/swap_u16_inc.py
	@mkdir -p $(dir $@)
	$(V)$(PYTHON) tools/psp/swap_u16_inc.py $< $@

$(BUILD_DIR)/src/crash_screen.o: $(BUILD_DIR)/textures/crash_screen/crash_screen_font.ia1.inc.c
$(BUILD_DIR)/textures/crash_screen/crash_screen_font.ia1.inc.c: textures/crash_screen/crash_screen_font.ia1.png
	$(V)$(N64GRAPHICS) -i $@ -g $< -f ia1 -s u8

#==============================================================================#
# Compilation                                                                  #
#==============================================================================#
CFLAGS_STAMP := $(BUILD_DIR)/cflags.stamp
$(shell mkdir -p $(BUILD_DIR); [ -f $(CFLAGS_STAMP) ] && [ "$$(cat $(CFLAGS_STAMP))" = "$(CFLAGS)" ] || echo "$(CFLAGS)" > $(CFLAGS_STAMP))

# The N64 build iconv's these to EUC-JP (Makefile: EUC_JP_FILES) and the game's
# text printer reads EUC-JP: the no-record holder "ーーーー", the fullwidth
# 1ｓ/2ｎ/3ｒ/4ｔ rank glyphs, the Japanese credits. Compiled as UTF-8 each
# character became 3 bytes the printer paired wrongly -- a long run of junk
# glyphs after every empty BEST RECORDS / BEST LAP on the map select. Only
# string and character literals change.
EUC_JP_FILES := src/ending/credits.c src/cpu_vehicles_camera_path.c src/menu_items.c
$(EUC_JP_FILES:%.c=$(BUILD_DIR)/%.o): CFLAGS += -finput-charset=UTF-8 -fexec-charset=EUC-JP
$(EUC_JP_FILES:%.c=$(BUILD_DIR)/%.o): Makefile.handheld

$(BUILD_DIR)/%.o: %.c $(SWAPPED_INC_FILES) $(CFLAGS_STAMP)
	$(call print,Compiling:,$<,$@)
	$(V)$(CC) -c $(CFLAGS) -MMD -MP -MF $(BUILD_DIR)/$*.d -o $@ $<

$(SEG_TABLES_C): tools/psp/gen_seg_tables.py $(wildcard courses/*/course_data.h courses/*/course_displaylists.inc.h) $(wildcard yamls/us/*.yml)
	$(call print,Generating:,$@,)
	$(V)$(PYTHON) tools/psp/gen_seg_tables.py $@
$(SEG_TABLES_C:.c=.o): $(SEG_TABLES_C)
	$(V)$(CC) -c $(CFLAGS) -o $@ $<

# Data .s files: rewrite .word/.hword to big-endian bytes, then assemble.
$(BUILD_DIR)/%.s: %.s tools/psp/asm_be.py
	$(V)$(ASM_BE) $< $@
$(BUILD_DIR)/%.o: $(BUILD_DIR)/%.s $(STANDALONE_TEXTURE_MIO0_FILES) $(RAW_TEXTURE_FILES)
	$(call print,Assembling:,$<,$@)
	$(V)$(AS) $(ASFLAGS) -o $@ $<
.PRECIOUS: $(BUILD_DIR)/%.s

#==============================================================================#
# Link                                                                         #
#==============================================================================#
# The shipped ELF: asset objects' .data renamed to .assetdata (in place, dates
# kept so make does not rebuild them), region NOLOAD -> symbols and addresses
# only, no bytes. The asset ELF is the same link with the region as PROGBITS
# plus --emit-relocs (-q), so make_assets.py can see the pointer words.
$(ELF): $(O_FILES) $(STAMP_O) $(LD_NOLOAD)
	$(call print,Linking:,$@,)
	$(V)for o in $(ASSET_OBJS); do $(OBJCOPY) --preserve-dates $(ASSET_RENAME_FLAGS) $$o; done
	$(V)bad=0; for o in $(ASSET_OBJS); do if $(OBJDUMP) -h $$o | grep -qE '^ +[0-9]+ +\.(data|rodata)(\.|$$| )'; then echo "ASSET SPLIT: $$o still has a .data/.rodata section (add it to ASSET_RENAMES)"; bad=1; fi; done; [ $$bad -eq 0 ]
	$(V)$(LD) $(LDFLAGS) -Wl,-T,$(LD_NOLOAD) -o $@ $(O_FILES) $(STAMP_O) $(LIBS)
	@ls -lh $@

$(ELF_ASSETS): $(O_FILES) $(STAMP_O) $(LD_PROGBITS) $(ELF)
	$(call print,Linking:,$@,)
	$(V)$(LD) $(LDFLAGS) -Wl,-q -Wl,-T,$(LD_PROGBITS) -o $@ $(O_FILES) $(STAMP_O) $(LIBS)

$(ASSETS_BIN): $(ELF_ASSETS) $(ELF) tools/psp/make_assets.py
	$(V)python3 tools/psp/make_assets.py $(ELF_ASSETS) $(ELF) -o $@ --page 4096

-include $(DEP_FILES)
.SUFFIXES:
